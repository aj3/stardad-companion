<Project Sdk="Microsoft.NET.Sdk">
  <!-- StarDad Companion: a tray icon and a themed panel that put a player's StarDexs file in the game when they ask.
       The tray icon is plain Win32 (LibraryImport); the panel is Avalonia (open source, native rendering, no browser engine). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>StarDadCompanion</AssemblyName>
    <RootNamespace>StarDexs.Sync</RootNamespace>
    <Version>0.4.4</Version>
    <Product>StarDad Companion</Product>
    <Company>AJ Solutions, LLC</Company>
    <Description>Syncs your StarDad logs and file every 3 hours by default, or on your chosen schedule.</Description>
    <ApplicationIcon>stardad.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- One self-contained, trimmed file: no .NET install needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <!-- Only the Windows backend and the Skia renderer: Avalonia.Desktop would bring Linux pieces (and their advisories) this app never uses. -->
    <PackageReference Include="Avalonia.Win32" Version="11.3.2" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarDexs.Sync.Core\StarDexs.Sync.Core.csproj" />
  </ItemGroup>
</Project>
